# Bruk et eget HTTPS-vertsnavn for å prøve backend-branchen.
# Erstatt alle forekomster av itlab.example.test og sertifikatstiene.
server {
    listen 80;
    server_name itlab.example.test;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name itlab.example.test;
    ssl_certificate /etc/letsencrypt/live/itlab.example.test/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/itlab.example.test/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /srv/it-laben-backend/current/build;
    index index.html;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;
    client_max_body_size 16k;

    location /api/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
        add_header Cache-Control no-store always;
    }
    location /_app/immutable/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location / {
        try_files $uri $uri/ =404;
        add_header Cache-Control no-cache;
    }
}
