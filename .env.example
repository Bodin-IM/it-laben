# Lokal utvikling. Kopier til .env. Ingen hemmeligheter skal inn i Git.
APP_ORIGIN=http://localhost:5173
API_PORT=3001
ITLAB_DB_PATH=data/it-laben.sqlite
# Produksjon: NODE_ENV=production og APP_ORIGIN=https://ditt-faste-vertsnavn
# Ekstra adresser til samme installasjon, kommaseparert og med HTTPS i produksjon:
# APP_ORIGIN_ALIASES=https://10.100.0.14

# KI-pilot i Redd chatten. Tom modell betyr at piloten er slått av.
# Bruk et nøyaktig modellnavn fra ollama list på KI-serveren.
LAB_PARTNER_MODEL=
# Full adresse til Ollamas chat-endepunkt, eventuelt en proxy med samme kontrakt.
LAB_PARTNER_OLLAMA_URL=http://127.0.0.1:11434/api/chat
# Valgfri Bearer-nøkkel til proxyen. Lagres bare på serveren.
LAB_PARTNER_API_TOKEN=
LAB_PARTNER_TIMEOUT_MS=45000
LAB_PARTNER_CONCURRENCY=2
# For modeller som støtter tenkemodus kan false gi kortere ventetid.
# Tom verdi bruker modellens standard. Ikke send feltet til modeller som ikke støtter det.
LAB_PARTNER_THINK=
